# Секреты. Скопируйте в .env и заполните значения.
DEBUG=False
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_AUDIENCE=ejournal
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=ejournal
DB_USER=ejournal
DB_PASSWORD=change-me-to-a-random-password-at-least-16-characters
DB_HOST=localhost
DB_PORT=5432

# Сквозная авторизация
JWT_TTL=300
TASK_STALE_AFTER_SECONDS=3600

# Безопасность (ФСТЭК-17, 2 класс)
MAX_FAILED_LOGIN_ATTEMPTS=10
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
SECURE_HSTS_SECONDS=31536000

# Gunicorn доступен только локальному TLS-терминатору. Меняйте адрес лишь для
# изолированной доверенной сети между proxy и приложением.
WEB_BIND_ADDRESS=127.0.0.1
