# Секреты. Скопируйте в .env и заполните значения.
DEBUG=False
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_AUDIENCE=ejournal
ALLOWED_HOSTS=localhost,127.0.0.1
# Полный lowercase SHA развёртываемого Git commit; обязателен для OCI provenance.
VCS_REF=

# PostgreSQL
DB_NAME=ejournal
DB_USER=ejournal
DB_PASSWORD=change-me-to-a-random-password-at-least-16-characters
DB_HOST=localhost
DB_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=3

# Сквозная авторизация
JWT_TTL=300
# Не заполняйте для server-to-server интеграции. Для browser POST перечислите
# только доверенные HTTPS origins, например https://sso.example.ru
TOKEN_LOGIN_TRUSTED_ORIGINS=
TASK_STALE_AFTER_SECONDS=3600
LOG_LEVEL=INFO

# Безопасность (ФСТЭК-17, 2 класс)
MAX_FAILED_LOGIN_ATTEMPTS=10
SESSION_COOKIE_SECURE=True
# Скользящий таймаут бездействия web-сессии, 5 минут — 12 часов.
SESSION_COOKIE_AGE=28800
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
# Proxy обязан перезаписывать X-Forwarded-For одним адресом клиента.
TRUST_PROXY_CLIENT_IP_HEADER=True
# IP/CIDR непосредственного TLS proxy; для proxy на Docker host укажите адрес,
# который видит контейнер. Не добавляйте клиентские сети.
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
SECURE_HSTS_SECONDS=31536000

# Gunicorn доступен только локальному TLS-терминатору. Меняйте адрес лишь для
# изолированной доверенной сети между proxy и приложением.
WEB_BIND_ADDRESS=127.0.0.1
