# секреты для локального окружения
DEBUG=False
SECRET_KEY=change-me
JWT_SECRET=change-me-too
JWT_AUDIENCE=ejournal
ALLOWED_HOSTS=localhost,127.0.0.1
# полный sha развертываемого commit
VCS_REF=

# postgresql
DB_NAME=ejournal
DB_USER=ejournal
DB_PASSWORD=change-me-to-a-random-password-at-least-16-characters
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=require
# ca файл для verify ca и verify full
DB_SSLROOTCERT=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=3

# сквозная авторизация
JWT_TTL=300
# доверенные https origins для браузерной интеграции
TOKEN_LOGIN_TRUSTED_ORIGINS=
# репозиторий сотрудников local или http
# контракт http возвращает json профиль сотрудника по guid
ACCOUNT_REPOSITORY_BACKEND=local
ACCOUNT_REPOSITORY_URL=
ACCOUNT_REPOSITORY_TOKEN=
ACCOUNT_REPOSITORY_TIMEOUT=5
TASK_STALE_AFTER_SECONDS=3600
LOG_LEVEL=INFO

# безопасность
MAX_FAILED_LOGIN_ATTEMPTS=10
SESSION_COOKIE_SECURE=True
# таймаут бездействия web сессии
SESSION_COOKIE_AGE=28800
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
# proxy перезаписывает forwarded for одним адресом клиента
TRUST_PROXY_CLIENT_IP_HEADER=True
# адреса непосредственного tls proxy без клиентских сетей
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
SECURE_HSTS_SECONDS=31536000

# gunicorn доступен только tls терминатору
WEB_BIND_ADDRESS=127.0.0.1
