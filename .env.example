# Секреты. Скопируйте в .env и заполните значения.
DEBUG=False
SECRET_KEY=change-me
JWT_SECRET=change-me-too
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=ejournal
DB_USER=ejournal
DB_PASSWORD=ejournal
DB_HOST=localhost
DB_PORT=5432

# Сквозная авторизация
JWT_TTL=300

# Безопасность (ФСТЭК-17, 2 класс)
MAX_FAILED_LOGIN_ATTEMPTS=10
SESSION_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False