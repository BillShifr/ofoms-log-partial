# Production-шаблон для текущего контура. Скопируйте в .env и заполните секреты.
DEBUG=False
SECRET_KEY=change-me-to-a-random-secret-at-least-50-characters
JWT_SECRET=change-me-to-a-separate-random-secret-at-least-50-characters
JWT_AUDIENCE=ejournal
ALLOWED_HOSTS=journal.example.ru
VCS_REF=
REGISTRY_AUTH_FILE=/home/vladislav/.config/containers/auth.json

DB_NAME=journal
DB_USER=journal
DB_PASSWORD=change-me-to-the-real-database-password
DB_HOST=192.168.1.239
DB_PORT=5432
DB_SSLMODE=disable
ALLOW_INSECURE_DB_CONNECTION=true
DB_SSLROOTCERT=
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=3
DB_CONNECT_TIMEOUT=3

JWT_TTL=300
TOKEN_LOGIN_TRUSTED_ORIGINS=
ACCOUNT_REPOSITORY_BACKEND=local
ACCOUNT_REPOSITORY_URL=
ACCOUNT_REPOSITORY_TOKEN=
ACCOUNT_REPOSITORY_TIMEOUT=5
TASK_STALE_AFTER_SECONDS=3600
LOG_LEVEL=INFO

MAX_FAILED_LOGIN_ATTEMPTS=10
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_AGE=28800
SECURE_SSL_REDIRECT=True
TRUST_PROXY_SSL_HEADER=True
TRUST_PROXY_CLIENT_IP_HEADER=True
TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
SECURE_HSTS_SECONDS=31536000
WEB_BIND_ADDRESS=127.0.0.1
# Включить только для первого запуска на подтвержденной БД journal.portal.tfoms v1.
ALLOW_LEGACY_INPLACE_UPGRADE=false
# Абсолютный путь к полному custom-format pg_dump; нужен только при true выше.
LEGACY_UPGRADE_BACKUP_FILE=
