<?xml version="1.0" encoding="UTF-8"?>
<!--
  Схема файла обмена сотрудниками users*.xml.

  Восстановлена по коду импорта v1 (load_emploees.py): блок
  USER_COLLECTION с записями USERS (ФИО, GUID, e-mail).
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:element name="USER_COLLECTION">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="USERS" type="UsersType" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="UsersType">
    <xs:sequence>
      <xs:element name="USER_FULLNAME" type="xs:string"/>
      <xs:element name="USER_UUID" type="xs:string"/>
      <xs:element name="USER_EMAIL" type="xs:string" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

</xs:schema>